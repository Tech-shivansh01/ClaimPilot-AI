# Copy this file to .env and fill in your own keys.
# the app runs fine without these (mock mode) so you can demo it for free,
# but real AI results need a valid OPENAI_API_KEY

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini

# leave blank to skip vector DB stuff (duplicate claim check just gets skipped)
WEAVIATE_URL=http://localhost:8080

DATABASE_URL=sqlite:///./claimpilot.db
UPLOAD_DIR=./uploads

# comma-separated, no spaces needed - add your deployed frontend URL here once you have one
ALLOWED_ORIGINS=http://localhost:3000

# used by fraud agent, claims above this score go to manual review instead of auto decision
FRAUD_REVIEW_THRESHOLD=70
